---
import "../styles/global.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>VexFlow Tutorial - 音符ドラッグ&ドロップ</title>
  </head>
  <body>
    <main>
      <div class="p-8 max-w-4xl mx-auto">
        <h1 class="text-3xl mb-8 text-gray-800">音符ドラッグ&ドロップ</h1>

        <div class="notation-wrapper" style="position: relative; display: inline-block;">
          <div class="notation-container"></div>
          <div class="playhead" style="display: none; position: absolute; top: 0; left: 0; width: 3px; height: 100%; pointer-events: none;">
            <div style="position: absolute; left: 2px; top: 0; width: 4px; height: 100%; background: rgba(0,0,0,0.15); border-radius: 2px;"></div>
            <div style="position: absolute; left: 0; top: 0; width: 3px; height: 100%; background: linear-gradient(to bottom, #FF4444, #FF0000, #CC0000); border-radius: 1px;"></div>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2">
          <button
            class="play-button px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 disabled:bg-gray-300 disabled:cursor-not-allowed"
            disabled
          >
            読み込み中...
          </button>
          <button
            class="export-mp4-button px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 disabled:bg-gray-300 disabled:cursor-not-allowed"
            style="display: none;"
          >
            MP4で保存
          </button>
          <button
            class="export-mov-button px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 disabled:bg-gray-300 disabled:cursor-not-allowed"
            style="display: none;"
          >
            MOVで保存
          </button>
        </div>
        <div class="progress-container mt-3 w-80" style="display: none;">
          <div class="bg-gray-200 rounded-full h-3 overflow-hidden">
            <div class="progress-bar bg-green-500 h-3 rounded-full transition-all duration-100" style="width: 0%;"></div>
          </div>
          <p class="progress-text text-sm text-gray-600 mt-1">エクスポート中... 0%</p>
        </div>
      </div>
    </main>

    <script>
      import { AudioPlayer } from "../audio/audioPlayer";
      import { ScoreDocument } from "../models/ScoreDocument";
      import { Timeline } from "../models/Timeline";
      import { ScoreRenderer } from "../rendering/ScoreRenderer";
      import { playAllNotes, hidePlayhead } from "../playback";
      import { exportVideo, isWebCodecsSupported, type ExportFormat } from "../rendering/videoExporter";
      import { NoteInteraction } from "../interaction/NoteInteraction";

      const updateButton = (
        button: HTMLButtonElement,
        text: string,
        disabled: boolean,
      ): void => {
        button.textContent = text;
        button.disabled = disabled;
      };

      const setExportButtonsDisabled = (
        buttons: HTMLButtonElement[],
        disabled: boolean,
      ): void => {
        buttons.forEach(btn => btn.disabled = disabled);
      };

      function initScorePanel(wrapper: HTMLElement): void {
        const container = wrapper.querySelector<HTMLDivElement>('.notation-container')!;
        const playheadEl = wrapper.querySelector<HTMLDivElement>('.playhead')!;
        const parent = wrapper.parentElement!;
        const playButton = parent.querySelector<HTMLButtonElement>('.play-button')!;
        const exportMp4Button = parent.querySelector<HTMLButtonElement>('.export-mp4-button')!;
        const exportMovButton = parent.querySelector<HTMLButtonElement>('.export-mov-button')!;
        const progressContainer = parent.querySelector<HTMLDivElement>('.progress-container')!;
        const progressBar = progressContainer.querySelector<HTMLDivElement>('.progress-bar')!;
        const progressText = progressContainer.querySelector<HTMLParagraphElement>('.progress-text')!;

        const scoreDocument = ScoreDocument.createDefault();
        const renderer = new ScoreRenderer();
        const audioPlayer = new AudioPlayer();

        let noteXPositions = renderer.renderToSVG(container, scoreDocument);
        let isPlaying = false;

        // データ変更時の再レンダリング
        scoreDocument.on('change', () => {
          if (!isPlaying) {
            noteXPositions = renderer.renderToSVG(container, scoreDocument);
          }
        });

        // NoteInteraction セットアップ
        new NoteInteraction({
          wrapper,
          container,
          scoreDocument,
          getNoteXPositions: () => noteXPositions,
          isPlaybackActive: () => isPlaying,
        });

        updateButton(playButton, "再生", false);

        const exportButtons = [exportMp4Button, exportMovButton];
        if (isWebCodecsSupported()) {
          exportMp4Button.style.display = '';
          exportMovButton.style.display = '';
        }

        const handleExport = async (format: ExportFormat) => {
          playButton.disabled = true;
          setExportButtonsDisabled(exportButtons, true);
          progressContainer.style.display = '';
          progressBar.style.width = '0%';
          progressText.textContent = 'エクスポート中... 0%';

          try {
            const timeline = new Timeline(scoreDocument);
            const baseCanvases: HTMLCanvasElement[] = [];
            let canvasNoteXPositions: number[] = [];
            for (let i = 0; i < scoreDocument.notes.length; i++) {
              const { canvas, xPositions } = renderer.renderToCanvas(scoreDocument, i);
              baseCanvases.push(canvas);
              if (i === 0) canvasNoteXPositions = xPositions;
            }
            await exportVideo({
              format,
              document: scoreDocument,
              timeline,
              baseCanvases,
              noteXPositions: canvasNoteXPositions,
              onProgress: (progress) => {
                const pct = Math.round(progress * 100);
                progressBar.style.width = `${pct}%`;
                progressText.textContent = `エクスポート中... ${pct}%`;
              },
            });
            progressText.textContent = '完了しました';
          } catch (e) {
            console.error('Export failed:', e);
            progressText.textContent = `エラー: ${e instanceof Error ? e.message : String(e)}`;
          } finally {
            playButton.disabled = false;
            setExportButtonsDisabled(exportButtons, false);
            setTimeout(() => {
              progressContainer.style.display = 'none';
            }, 3000);
          }
        };

        playButton.addEventListener("click", async () => {
          isPlaying = true;
          updateButton(playButton, "再生中...", true);
          setExportButtonsDisabled(exportButtons, true);

          await audioPlayer.initialize();
          await audioPlayer.resume();

          const timeline = new Timeline(scoreDocument);

          playAllNotes(
            scoreDocument,
            timeline,
            container,
            renderer,
            audioPlayer,
            noteXPositions,
            playheadEl,
            () => {
              isPlaying = false;
              hidePlayhead(playheadEl);
              updateButton(playButton, "再生", false);
              setExportButtonsDisabled(exportButtons, false);
            },
          );
        });

        exportMp4Button.addEventListener("click", () => handleExport('mp4'));
        exportMovButton.addEventListener("click", () => handleExport('mov'));
      }

      const initialize = (): void => {
        const wrapper = document.querySelector<HTMLElement>('.notation-wrapper')!;
        initScorePanel(wrapper);
      };

      if (typeof window !== "undefined") {
        const start = () => requestAnimationFrame(initialize);
        if (document.readyState === "complete") {
          start();
        } else {
          window.addEventListener("load", start);
        }
      }
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </body>
</html>
