---
import "../styles/global.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>VexFlow Tutorial - 音符と音の同期</title>
  </head>
  <body>
    <main>
      <div class="p-8 max-w-4xl mx-auto">
        <h1 class="text-3xl mb-8 text-gray-800">音符と音の同期</h1>

        <div id="notation-wrapper" style="position: relative; display: inline-block;">
          <div id="notation"></div>
          <div id="playhead" style="display: none; position: absolute; top: 0; left: 0; width: 3px; height: 100%; pointer-events: none;">
            <div style="position: absolute; left: 2px; top: 0; width: 4px; height: 100%; background: rgba(0,0,0,0.15); border-radius: 2px;"></div>
            <div style="position: absolute; left: 0; top: 0; width: 3px; height: 100%; background: linear-gradient(to bottom, #FF4444, #FF0000, #CC0000); border-radius: 1px;"></div>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2">
          <button
            id="play-button"
            disabled
            class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 disabled:bg-gray-300 disabled:cursor-not-allowed"
          >
            読み込み中...
          </button>
          <button
            id="export-mp4-button"
            style="display: none;"
            class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 disabled:bg-gray-300 disabled:cursor-not-allowed"
          >
            MP4で保存
          </button>
          <button
            id="export-mov-button"
            style="display: none;"
            class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 disabled:bg-gray-300 disabled:cursor-not-allowed"
          >
            MOVで保存
          </button>
        </div>
        <div id="progress-container" style="display: none;" class="mt-3 w-80">
          <div class="bg-gray-200 rounded-full h-3 overflow-hidden">
            <div id="progress-bar" class="bg-green-500 h-3 rounded-full transition-all duration-100" style="width: 0%;"></div>
          </div>
          <p id="progress-text" class="text-sm text-gray-600 mt-1">エクスポート中... 0%</p>
        </div>
      </div>
    </main>

    <script>
      import { AudioPlayer } from "../audio/audioPlayer";
      import { ScoreDocument } from "../models/ScoreDocument";
      import { Timeline } from "../models/Timeline";
      import { ScoreRenderer } from "../rendering/ScoreRenderer";
      import { playAllNotes, hidePlayhead } from "../playback";
      import { exportVideo, isWebCodecsSupported, type ExportFormat } from "../rendering/videoExporter";

      // ボタンの状態を更新
      const updateButton = (
        button: HTMLButtonElement,
        text: string,
        disabled: boolean,
      ): void => {
        button.textContent = text;
        button.disabled = disabled;
      };

      // エクスポートボタン群の有効/無効を一括制御
      const setExportButtonsDisabled = (
        buttons: HTMLButtonElement[],
        disabled: boolean,
      ): void => {
        buttons.forEach(btn => btn.disabled = disabled);
      };

      // メイン初期化関数
      const initialize = async (): Promise<void> => {
        const notationEl = document.querySelector<HTMLDivElement>("#notation");
        const playButton = document.querySelector<HTMLButtonElement>("#play-button");
        const playheadEl = document.querySelector<HTMLDivElement>("#playhead");
        const exportMp4Button = document.querySelector<HTMLButtonElement>("#export-mp4-button");
        const exportMovButton = document.querySelector<HTMLButtonElement>("#export-mov-button");
        const progressContainer = document.querySelector<HTMLDivElement>("#progress-container");
        const progressBar = document.querySelector<HTMLDivElement>("#progress-bar");
        const progressText = document.querySelector<HTMLParagraphElement>("#progress-text");

        if (!notationEl || !playButton || !playheadEl ||
            !exportMp4Button || !exportMovButton ||
            !progressContainer || !progressBar || !progressText) return;

        const scoreDocument = ScoreDocument.createDefault();
        const timeline = new Timeline(scoreDocument);
        const renderer = new ScoreRenderer();
        const audioPlayer = new AudioPlayer();

        // 初期描画し、音符のX座標を取得
        const noteXPositions = renderer.renderToSVG(notationEl, scoreDocument);
        updateButton(playButton, "再生", false);

        // WebCodecs対応ブラウザでのみエクスポートボタンを表示
        const exportButtons = [exportMp4Button, exportMovButton];
        if (isWebCodecsSupported()) {
          exportMp4Button.style.display = '';
          exportMovButton.style.display = '';
        }

        // エクスポート処理
        const handleExport = async (format: ExportFormat) => {
          playButton.disabled = true;
          setExportButtonsDisabled(exportButtons, true);
          progressContainer.style.display = '';
          progressBar.style.width = '0%';
          progressText.textContent = 'エクスポート中... 0%';

          try {
            // 音符ごとにハイライト済みのCanvas画像を事前生成
            const baseCanvases: HTMLCanvasElement[] = [];
            let canvasNoteXPositions: number[] = [];
            for (let i = 0; i < scoreDocument.notes.length; i++) {
              const { canvas, xPositions } = renderer.renderToCanvas(scoreDocument, i);
              baseCanvases.push(canvas);
              if (i === 0) canvasNoteXPositions = xPositions;
            }
            await exportVideo({
              format,
              document: scoreDocument,
              timeline,
              baseCanvases,
              noteXPositions: canvasNoteXPositions,
              onProgress: (progress) => {
                const pct = Math.round(progress * 100);
                progressBar.style.width = `${pct}%`;
                progressText.textContent = `エクスポート中... ${pct}%`;
              },
            });

            progressText.textContent = '完了しました';
          } catch (e) {
            console.error('Export failed:', e);
            progressText.textContent = `エラー: ${e instanceof Error ? e.message : String(e)}`;
          } finally {
            playButton.disabled = false;
            setExportButtonsDisabled(exportButtons, false);
            setTimeout(() => {
              progressContainer.style.display = 'none';
            }, 3000);
          }
        };

        // 再生ボタンのイベントハンドラ
        playButton.addEventListener("click", async () => {
          updateButton(playButton, "再生中...", true);
          setExportButtonsDisabled(exportButtons, true);

          await audioPlayer.initialize();
          await audioPlayer.resume();

          playAllNotes(
            scoreDocument,
            timeline,
            notationEl,
            renderer,
            audioPlayer,
            noteXPositions,
            playheadEl,
            () => {
              hidePlayhead(playheadEl);
              updateButton(playButton, "再生", false);
              setExportButtonsDisabled(exportButtons, false);
            },
          );
        });

        // エクスポートボタンのイベントハンドラ
        exportMp4Button.addEventListener("click", () => handleExport('mp4'));
        exportMovButton.addEventListener("click", () => handleExport('mov'));
      };

      // CSS（Tailwind含む）の読み込み完了後に初期化
      if (typeof window !== "undefined") {
        const start = () => requestAnimationFrame(initialize);
        if (document.readyState === "complete") {
          start();
        } else {
          window.addEventListener("load", start);
        }
      }
    </script>

    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </body>
</html>
